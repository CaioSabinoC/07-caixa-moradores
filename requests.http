# =====================================================================
# 5. TOTAIS (RF3 — REGRA CENTRAL)
# =====================================================================

### 5.1 CA3 (teste #5) — total exato de "eventos" no dia 2026-01-15
# Esperado: categoria "eventos" = "31.00" (texto, exatamente 31.00)
# e total geral do período = "31.00". Não pode ser 31 nem 30.999999.
GET {{baseUrl}}/api/despesas/totais?de=2026-01-15&ate=2026-01-15

### 5.2 CA4 (teste #6) — período 2026-02-10 a 2026-02-20, limites inclusivos
# Esperado: "limpeza" = "60.00" (10 + 20 + 30) e total geral = "60.00".
# As despesas de 100,00 (dias 09 e 21) NÃO entram.
GET {{baseUrl}}/api/despesas/totais?de=2026-02-10&ate=2026-02-20

### 5.3 Listagem do mesmo período (confere com 5.2) — esperado 3 linhas
GET {{baseUrl}}/api/despesas?de=2026-02-10&ate=2026-02-20&categoria=limpeza

### 5.4 Totais sem filtro (tudo) — esperado 200
GET {{baseUrl}}/api/despesas/totais

### 5.5 Totais de período vazio — esperado 200, total geral "0.00", sem erro
GET {{baseUrl}}/api/despesas/totais?de=2000-01-01&ate=2000-01-31

### 5.6 Totais com "de" maior que "ate" — esperado 400
GET {{baseUrl}}/api/despesas/totais?de=2026-12-01&ate=2026-11-01

### 5.7 Totais com data inválida — esperado 400
GET {{baseUrl}}/api/despesas/totais?de=abc&ate=2026-11-30

### 5.8 Teste de ponto flutuante: 0.10 + 0.20 deve dar exatamente 0.30
# Rode 5.8a, 5.8b e depois 5.8c. Esperado: "0.30" (e não 0.30000000000000004).
# @name flutuanteA
POST {{baseUrl}}/api/despesas
Content-Type: {{json}}

{
  "descricao": "Float parcela 0.10",
  "valor": 0.10,
  "categoria": "administrativo",
  "data_despesa": "2026-03-05"
}

###
POST {{baseUrl}}/api/despesas
Content-Type: {{json}}

{
  "descricao": "Float parcela 0.20",
  "valor": 0.20,
  "categoria": "administrativo",
  "data_despesa": "2026-03-05"
}

###
GET {{baseUrl}}/api/despesas/totais?de=2026-03-05&ate=2026-03-05


# =====================================================================
# 6. CONFERIR (RF4), EDITAR (RF5) E EXCLUIR
# =====================================================================

### 6.1 Criar despesa para editar/conferir (guarda o id)
# @name despesaA
POST {{baseUrl}}/api/despesas
Content-Type: {{json}}

{
  "descricao": "Despesa A (para editar e conferir)",
  "valor": 80.00,
  "categoria": "manutencao",
  "data_despesa": "2026-11-05"
}

###
@idA = {{despesaA.response.body.id}}

### 6.2 RF5 — editar despesa NÃO conferida — esperado 200
PUT {{baseUrl}}/api/despesas/{{idA}}
Content-Type: {{json}}

{
  "descricao": "Despesa A (editada)",
  "valor": 85.50,
  "categoria": "limpeza"
}

### 6.3 Conferir a despesa A — esperado 200
PATCH {{baseUrl}}/api/despesas/{{idA}}/conferir

### 6.4 CA5 (teste #7) — editar despesa CONFERIDA — esperado 409
PUT {{baseUrl}}/api/despesas/{{idA}}
Content-Type: {{json}}

{
  "descricao": "Tentativa de editar conferida",
  "valor": 1.00,
  "categoria": "outros"
}

### 6.5 Excluir despesa CONFERIDA — esperado 409
DELETE {{baseUrl}}/api/despesas/{{idA}}

### 6.6 Conferir de novo (já conferida) — esperado 409
PATCH {{baseUrl}}/api/despesas/{{idA}}/conferir

### 6.7 Confirmar que a despesa A continua com os dados da edição 6.2
# (a tentativa 6.4 não pode ter alterado nada). Procure o id na lista.
GET {{baseUrl}}/api/despesas?de=2026-11-05&ate=2026-11-05

### 6.8 Criar despesa B (para excluir) e guardar o id
# @name despesaB
POST {{baseUrl}}/api/despesas
Content-Type: {{json}}

{
  "descricao": "Despesa B (para excluir)",
  "valor": 12.00,
  "categoria": "outros",
  "data_despesa": "2026-11-06"
}

###
@idB = {{despesaB.response.body.id}}

### 6.9 Excluir despesa NÃO conferida — esperado 204
DELETE {{baseUrl}}/api/despesas/{{idB}}

### 6.10 Excluir a mesma despesa de novo — esperado 404
DELETE {{baseUrl}}/api/despesas/{{idB}}


